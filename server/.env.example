# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# PostgreSQL Connection (required: all app data is stored here)
# e.g. postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/bhook_lgi

# Set to true for hosted Postgres (Render, Neon, Supabase, RDS) - they require SSL.
# Keep false for a local database.
DATABASE_SSL=false

# Address of the deployed frontend
FRONTEND_URL=http://localhost:5173

# Long random string used to sign login tokens, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
